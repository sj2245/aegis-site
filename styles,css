:root {
  --bg: #0d1117;
  --panel: rgba(18, 24, 32, 0.9);
  --panel-alt: rgba(25, 33, 42, 0.9);
  --line: rgba(255, 255, 255, 0.12);
  --text: #edf3f9;
  --muted: #9aa9b8;
  --accent: #8af0c1;
  --accent-strong: #5ee2a5;
  --shadow: rgba(0, 0, 0, 0.35);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top, rgba(98, 132, 160, 0.2), transparent 22%),
    linear-gradient(135deg, #0b1016 0%, #111821 42%, #0c1117 100%);
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

button,
a {
  font: inherit;
}

.page-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 56px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 10px 0 24px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.72rem;
}

.brand-mark {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #d8fff0);
  box-shadow: 0 0 18px rgba(138, 240, 193, 0.7);
}

.nav {
  display: inline-flex;
  align-items: center;
  gap: 28px;
}

.nav a,
.nav-cta {
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.nav a:hover,
.nav-cta:hover {
  color: var(--text);
}

.nav-cta {
  padding: 10px 18px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.02);
}

.hero {
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  align-items: center;
  gap: 32px;
  min-height: 620px;
  padding: 24px 0 20px;
}

.hero-copy {
  max-width: 560px;
}

.eyebrow {
  margin: 0 0 16px;
  color: var(--accent);
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-size: 0.72rem;
  font-weight: 700;
}

h1 {
  margin: 0;
  font-size: clamp(3rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.intro {
  margin: 22px 0 0;
  max-width: 560px;
  color: var(--muted);
  font-size: 1.04rem;
  line-height: 1.75;
}

.actions {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 28px;
  flex-wrap: wrap;
}

button {
  border: none;
  cursor: pointer;
  border-radius: 999px;
  padding: 0.96rem 1.5rem;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

button:hover {
  transform: translateY(-1px);
}

.primary {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
  color: #07110d;
  font-weight: 700;
  box-shadow: 0 14px 26px rgba(94, 226, 165, 0.26);
}

.secondary {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--text);
}

.metrics {
  list-style: none;
  display: flex;
  gap: 22px;
  padding: 0;
  margin: 34px 0 0;
  flex-wrap: wrap;
}

.metrics li {
  min-width: 120px;
  padding: 16px 18px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(2px);
}

.metrics strong {
  display: block;
  font-size: 1.4rem;
  margin-bottom: 6px;
}

.metrics span {
  color: var(--muted);
  font-size: 0.77rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.turret-scene {
  position: relative;
  width: min(100%, 520px);
  aspect-ratio: 1.08;
  border: 1px solid var(--line);
  border-radius: 30px;
  background:
    radial-gradient(circle at 50% 35%, rgba(138, 240, 193, 0.18), transparent 20%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 30px 60px var(--shadow);
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(18px);
}

.orb-one {
  width: 200px;
  height: 200px;
  background: rgba(144, 218, 255, 0.16);
  top: 18%;
  left: 12%;
}

.orb-two {
  width: 220px;
  height: 220px;
  background: rgba(138, 240, 193, 0.12);
  right: 8%;
  bottom: 11%;
}

.ring {
  position: absolute;
  width: 260px;
  height: 260px;
  left: 50%;
  top: 54%;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 50%;
  box-shadow: inset 0 0 25px rgba(255, 255, 255, 0.04);
}

.mount {
  position: absolute;
  width: 84px;
  height: 84px;
  left: 50%;
  bottom: 15%;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
}

.base {
  position: absolute;
  width: 200px;
  height: 78px;
  left: 50%;
  bottom: 12%;
  transform: translateX(-50%);
  border-radius: 20px;
  background: linear-gradient(180deg, #202a35, #171d26);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 16px 28px rgba(0, 0, 0, 0.22);
}

.turret-body {
  position: absolute;
  width: 170px;
  height: 110px;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  background: linear-gradient(130deg, #1d2530 0%, #232d39 40%, #1a212a 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 26px;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
}

.barrel {
  position: absolute;
  width: 220px;
  height: 22px;
  left: 56%;
  top: 36%;
  transform: translateY(-50%) rotate(-8deg);
  border-radius: 999px;
  background: linear-gradient(90deg, #dfe9f3 0%, #a9b5c2 20%, #1a202b 45%, #1a202b 100%);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
}

.barrel::before {
  content: "";
  position: absolute;
  width: 62px;
  height: 12px;
  right: -18px;
  top: 5px;
  border-radius: 999px;
  background: linear-gradient(90deg, #a7b3bf, #f2f6fb);
}

.camera {
  position: absolute;
  width: 28px;
  height: 28px;
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: linear-gradient(135deg, #9de9c6, #6f8ef4);
  border: 4px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 0 16px rgba(138, 240, 193, 0.38);
}

.features {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 16px;
}

.features article {
  padding: 26px 22px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.02);
}

.feature-tag {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--accent);
  font-size: 0.77rem;
  letter-spacing: 0.12em;
  font-weight: 700;
}

.features h2 {
  margin: 0 0 10px;
  font-size: 1.4rem;
}

.features p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

@media (max-width: 820px) {
  .topbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-copy {
    max-width: none;
  }

  .actions,
  .metrics {
    justify-content: center;
  }

  .features {
    grid-template-columns: 1fr;
  }
}
